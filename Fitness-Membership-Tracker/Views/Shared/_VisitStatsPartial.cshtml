@model VisitStatsViewModel

@{
    // ── Determine which page is hosting this partial ──────────────────────────
    // On the Dashboard the form must navigate to Dashboard?from=…&to=…
    // On the Visits page it must navigate to Visits?from=…&to=…
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Dashboard";
    var currentCtrl   = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Admin";

    // ── Full dataset → JSON for the client-side chart ─────────────────────────
    var fullData = Model.DailyVisitCounts
        .OrderBy(kv => kv.Key)
        .Select(kv => new { date = kv.Key.ToString("yyyy-MM-dd"), count = kv.Value })
        .ToList();

    var fullDataJson = System.Text.Json.JsonSerializer.Serialize(fullData);

    var defaultFrom = Model.From.ToString("yyyy-MM-dd");
    var defaultTo   = Model.To.ToString("yyyy-MM-dd");

    // Unique IDs so two instances on the same page never collide
    var uid     = Guid.NewGuid().ToString("N")[..8];
    var chartId = "vc_"  + uid;
    var fromId  = "vf_"  + uid;
    var toId    = "vt_"  + uid;
    var btnId   = "vb_"  + uid;
    var totalId = "vs1_" + uid;
    var avgId   = "vs2_" + uid;
    var peakDId = "vs3_" + uid;
    var peakCId = "vs4_" + uid;
}

@* ── Date-range filter ──────────────────────────────────────────────────── *@
@* 
   The form submits to the current action (Dashboard or Visits).
   This means the controller re-runs with the new dates, loads the correct
   data window from the DB, and the chart initialises on that window.
   After that, the client-side filter lets the user narrow further without
   another reload.
*@
<form method="get" asp-controller="@currentCtrl" asp-action="@currentAction"
      class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label for="@fromId" class="form-label mb-1 text-muted small">From</label>
        <input type="date" id="@fromId" name="from" value="@defaultFrom"
               class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <label for="@toId" class="form-label mb-1 text-muted small">To</label>
        <input type="date" id="@toId" name="to" value="@defaultTo"
               class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <button id="@btnId" type="submit" class="btn btn-primary btn-sm">Apply</button>
    </div>
</form>

@* ── KPI cards ───────────────────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted small mb-1">Total Visits</p>
                <h3 id="@totalId" class="mb-0 fw-bold">@Model.TotalVisits</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted small mb-1">Avg / Day</p>
                <h3 id="@avgId" class="mb-0 fw-bold">@Model.AveragePerDay.ToString("F1")</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted small mb-1">Peak Day</p>
                <h3 id="@peakDId" class="mb-0 fw-bold">
                    @(Model.PeakDay.HasValue ? Model.PeakDay.Value.ToString("dd MMM yyyy") : "—")
                </h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted small mb-1">Peak Count</p>
                <h3 id="@peakCId" class="mb-0 fw-bold">@Model.PeakCount</h3>
            </div>
        </div>
    </div>
</div>

@* ── Chart card ──────────────────────────────────────────────────────────── *@
<div class="card shadow-sm mb-4">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="text-muted mb-0">Visits Per Day</h6>
            <div class="d-flex gap-3 small text-muted">
                <span>
                    <span style="display:inline-block;width:12px;height:12px;
                                 background:rgba(27,110,194,0.75);border-radius:2px;
                                 margin-right:4px;"></span>Daily visits
                </span>
                <span>
                    <span style="display:inline-block;width:22px;height:3px;
                                 background:#f59e0b;border-radius:2px;
                                 margin-right:4px;vertical-align:middle;"></span>3-day avg
                </span>
            </div>
        </div>

        <div style="position:relative;height:260px;">
            <canvas id="@chartId"></canvas>
        </div>

    </div>
</div>

@* Load Chart.js once per page even when the partial renders twice *@
@if (!ViewData.ContainsKey("_chartjsLoaded"))
{
    ViewData["_chartjsLoaded"] = true;
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
}

<script>
(function () {
    var ALL_DATA = @Html.Raw(fullDataJson);

    var canvas  = document.getElementById('@chartId');
    var fromEl  = document.getElementById('@fromId');
    var toEl    = document.getElementById('@toId');
    var totalEl = document.getElementById('@totalId');
    var avgEl   = document.getElementById('@avgId');
    var peakDEl = document.getElementById('@peakDId');
    var peakCEl = document.getElementById('@peakCId');

    if (!canvas) return;

    var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun',
                  'Jul','Aug','Sep','Oct','Nov','Dec'];

    function fmtLabel(iso) {
        var p = iso.split('-');
        return parseInt(p[2], 10) + ' ' + MONTHS[parseInt(p[1], 10) - 1];
    }
    function fmtFull(iso) {
        var p = iso.split('-');
        return parseInt(p[2], 10) + ' ' + MONTHS[parseInt(p[1], 10) - 1] + ' ' + p[0];
    }

    var chart = new Chart(canvas, {
        data: {
            labels: [],
            datasets: [
                {
                    type: 'bar',
                    label: 'Daily Visits',
                    data: [],
                    backgroundColor: 'rgba(27, 110, 194, 0.72)',
                    borderColor:     'rgba(27, 110, 194, 1)',
                    borderWidth: 1,
                    borderRadius: 4,
                    order: 2,
                    yAxisID: 'y'
                },
                {
                    type: 'line',
                    label: '3-Day Avg',
                    data: [],
                    borderColor:          'rgba(245, 158, 11, 1)',
                    backgroundColor:      'rgba(245, 158, 11, 0.10)',
                    borderWidth: 2.5,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    pointBackgroundColor: 'rgba(245, 158, 11, 1)',
                    tension: 0.35,
                    fill: false,
                    spanGaps: false,
                    order: 1,
                    yAxisID: 'y'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function (ctx) {
                            if (ctx.parsed.y === null || ctx.parsed.y === undefined) return null;
                            if (ctx.datasetIndex === 1)
                                return ' 3-day avg: ' + ctx.parsed.y.toFixed(1);
                            var v = ctx.parsed.y;
                            return ' ' + v + ' visit' + (v !== 1 ? 's' : '');
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { maxRotation: 45, autoSkip: true, maxTicksLimit: 15 }
                },
                y: {
                    beginAtZero: true,
                    ticks: { precision: 0 },
                    grid: { color: 'rgba(0,0,0,0.05)' }
                }
            }
        }
    });

    // ── Render with the data the server already sent ─────────────────────────
    // We do NOT do a client-side date filter here — the server already sliced
    // the data to the requested window, so we just display everything in ALL_DATA.
    function renderAll() {
        var labels  = ALL_DATA.map(function (d) { return fmtLabel(d.date); });
        var counts  = ALL_DATA.map(function (d) { return d.count; });
        var rolling = counts.map(function (_, i) {
            return i < 2 ? null : (counts[i-2] + counts[i-1] + counts[i]) / 3.0;
        });

        chart.data.labels           = labels;
        chart.data.datasets[0].data = counts;
        chart.data.datasets[1].data = rolling;
        chart.update();

        // KPI cards already rendered by Razor from the server — no need to rewrite
    }

    renderAll();

})();
</script>
