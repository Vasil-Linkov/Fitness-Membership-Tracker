@model List<Fitness_Membership_Tracker.Data.DataModels.Payment>

<div class="card shadow-sm mt-4">
    <div class="card-body">
        <h4 class="card-title mb-3">Payment History</h4>

        @if (Model == null || !Model.Any())
        {
            <p class="text-muted mb-0">No payments found for your account.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Currency</th>
                            <th>Method</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.OrderByDescending(p => p.PaymentDate))
                        {
                            <tr>
                                <td>@payment.PaymentDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@payment.Amount</td>
                                <td>@payment.Currency</td>
                                <td>@payment.PaymentMethod</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>