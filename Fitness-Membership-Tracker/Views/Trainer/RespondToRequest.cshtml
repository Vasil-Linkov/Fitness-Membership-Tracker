@model RespondToRequestViewModel

@{
    ViewData["Title"] = "Respond to Request";
}

<div class="container mt-4">
    <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary mb-3">← Back to Dashboard</a>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h4 class="fw-bold mb-1">Training Request</h4>
                    <p class="text-muted mb-4">
                        From <strong>@Model.Request.Member?.Email</strong> —
                        <span class="small">@Model.Request.RequestedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.Request.MemberMessage))
                    {
                        <div class="alert alert-light border mb-4">
                            <p class="mb-1 small fw-semibold text-muted">Member's message:</p>
                            <p class="mb-0">@Model.Request.MemberMessage</p>
                        </div>
                    }

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Your Response
                            <span class="text-muted fw-normal small">(optional)</span>
                        </label>
                        <textarea id="responseText" class="form-control" rows="4"
                                  placeholder="Add a note for the member..."
                                  maxlength="500"></textarea>
                    </div>

                    <div class="d-flex gap-3">

                        @* Accept *@
                        <form asp-action="AcceptRequest" method="post" class="flex-fill">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@Model.Request.Id" />
                            <input type="hidden" name="trainerResponse" id="acceptResponse" />
                            <button type="submit" class="btn btn-success w-100"
                                    onclick="document.getElementById('acceptResponse').value = document.getElementById('responseText').value">
                                Accept
                            </button>
                        </form>

                        @* Reject *@
                        <form asp-action="RejectRequest" method="post" class="flex-fill">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@Model.Request.Id" />
                            <input type="hidden" name="trainerResponse" id="rejectResponse" />
                            <button type="submit" class="btn btn-danger w-100"
                                    onclick="document.getElementById('rejectResponse').value = document.getElementById('responseText').value; return confirm('Reject this request?');">
                                Reject
                            </button>
                        </form>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
