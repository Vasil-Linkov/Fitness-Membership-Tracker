@model TrainerSchedulePageViewModel

@{
    ViewData["Title"] = "My Schedule";
    var dayNames = new[] { "Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday" };
    var now      = DateTime.Now;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">My Schedule</h2>
            <p class="text-muted mb-0">
                Availability slots &amp; booked sessions for
                <strong>@Model.Trainer.FirstName @Model.Trainer.LastName</strong>.
            </p>
        </div>
        <a asp-action="BookSession" class="btn btn-primary">+ Book Session</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        @* ── Availability (configured by admin) ── *@
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header border-0">
                    <h5 class="mb-0 fw-semibold">Weekly Availability</h5>
                    <p class="text-muted small mb-0">Set by your administrator.</p>
                </div>
                <div class="card-body">
                    @if (!Model.AvailabilitySlots.Any())
                    {
                        <p class="text-muted mb-0">No availability slots configured yet.</p>
                    }
                    else
                    {
                        var grouped = Model.AvailabilitySlots
                            .GroupBy(s => s.DayOfWeek)
                            .OrderBy(g => g.Key);

                        <div class="d-flex flex-column gap-2">
                            @foreach (var group in grouped)
                            {
                                <div class="d-flex align-items-start gap-2">
                                    <span class="badge bg-light text-dark border fw-semibold"
                                          style="min-width:90px;">
                                        @dayNames[group.Key]
                                    </span>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var slot in group.OrderBy(s => s.StartTime))
                                        {
                                            <span class="badge bg-primary">
                                                @slot.StartTime.ToString(@"hh\:mm") –
                                                @slot.EndTime.ToString(@"hh\:mm")
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Booked sessions ── *@
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0 fw-semibold">Booked Sessions</h5>
                        <p class="text-muted small mb-0">Upcoming first, then past.</p>
                    </div>
                    <a asp-action="BookSession" class="btn btn-sm btn-outline-primary">+ New</a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Sessions.Any())
                    {
                        <p class="text-muted p-4 mb-0">No sessions booked yet.</p>
                    }
                    else
                    {
                        var upcoming = Model.Sessions
                            .Where(s => s.SessionDate >= DateTime.UtcNow)
                            .OrderBy(s => s.SessionDate)
                            .ToList();
                        var past = Model.Sessions
                            .Where(s => s.SessionDate < DateTime.UtcNow)
                            .OrderByDescending(s => s.SessionDate)
                            .ToList();

                        @* Upcoming *@
                        @if (upcoming.Any())
                        {
                            <div class="px-4 pt-3 pb-1">
                                <p class="text-muted small fw-semibold mb-2 text-uppercase" style="letter-spacing:.05em;">
                                    Upcoming (@upcoming.Count)
                                </p>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date &amp; Time</th>
                                            <th>Member</th>
                                            <th>Duration</th>
                                            <th>Notes</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in upcoming)
                                        {
                                            <tr>
                                                <td class="fw-semibold">
                                                    @s.SessionDate.ToLocalTime().ToString("ddd dd MMM")
                                                    <span class="text-muted small d-block">
                                                        @s.SessionDate.ToLocalTime().ToString("HH:mm")
                                                    </span>
                                                </td>
                                                <td>@s.Member?.Email</td>
                                                <td>@s.DurationMinutes min</td>
                                                <td class="text-muted small">
                                                    @(string.IsNullOrEmpty(s.Notes) ? "—" : s.Notes)
                                                </td>
                                                <td class="text-end">
                                                    <form asp-action="DeleteSession" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="sessionId" value="@s.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                onclick="return confirm('Remove this session?');">
                                                            Remove
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @* Past *@
                        @if (past.Any())
                        {
                            <div class="px-4 pt-3 pb-1">
                                <p class="text-muted small fw-semibold mb-2 text-uppercase" style="letter-spacing:.05em;">
                                    Past (@past.Count)
                                </p>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0 text-muted">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date &amp; Time</th>
                                            <th>Member</th>
                                            <th>Duration</th>
                                            <th>Notes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in past.Take(20))
                                        {
                                            <tr>
                                                <td>
                                                    @s.SessionDate.ToLocalTime().ToString("ddd dd MMM")
                                                    <span class="small d-block">
                                                        @s.SessionDate.ToLocalTime().ToString("HH:mm")
                                                    </span>
                                                </td>
                                                <td>@s.Member?.Email</td>
                                                <td>@s.DurationMinutes min</td>
                                                <td class="small">
                                                    @(string.IsNullOrEmpty(s.Notes) ? "—" : s.Notes)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

    </div>
</div>
