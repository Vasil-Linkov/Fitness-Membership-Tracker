@model MyTrainerViewModel

@{
    ViewData["Title"] = "My Trainer";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">My Trainer</h2>
            <p class="text-muted mb-0">Your coaching relationship and request history.</p>
        </div>
        @if (Model.ActiveRelationship == null)
        {
            <a asp-action="Browse" class="btn btn-primary">Find a Trainer</a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── Active relationship ── *@
    @if (Model.ActiveRelationship != null)
    {
        var rel = Model.ActiveRelationship;
        var t = rel.Trainer;

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <h4 class="fw-bold mb-1">@t?.FirstName @t?.LastName</h4>
                        <span class="badge bg-info text-dark me-2">@t?.Specialization</span>
                        <span class="badge bg-success">Active</span>
                        <p class="text-muted small mt-2 mb-1">
                            📍 @t?.Location?.City — @t?.Location?.Address
                        </p>
                        <p class="text-muted small mb-1">📞 @t?.PhoneNumber</p>
                        <p class="text-muted small mb-0">
                            Training since: @rel.StartDate.ToLocalTime().ToString("dd MMMM yyyy")
                        </p>
                    </div>
                    <form asp-action="EndRelationship" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="trainerTraineeId" value="@rel.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Are you sure you want to end your training relationship?');">
                            End Relationship
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-light border mb-4">
            You don't have an active trainer right now.
            <a asp-action="Browse" class="alert-link">Browse available trainers →</a>
        </div>
    }

    @* ── Request history ── *@
    <h5 class="fw-semibold mb-3">Request History</h5>

    @if (!Model.RequestHistory.Any())
    {
        <p class="text-muted">No requests yet.</p>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Trainer</th>
                                <th>Sent</th>
                                <th>Status</th>
                                <th>Response</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model.RequestHistory)
                            {
                                <tr>
                                    <td>
                                        <strong>@req.Trainer?.FirstName @req.Trainer?.LastName</strong>
                                        <br /><span class="text-muted small">@req.Trainer?.Specialization</span>
                                    </td>
                                    <td class="small">@req.RequestedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                    <td>
                                        @switch (req.Status)
                                        {
                                            case TrainingRequestStatus.Pending:
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case TrainingRequestStatus.Accepted:
                                                <span class="badge bg-success">Accepted</span>
                                                break;
                                            case TrainingRequestStatus.Rejected:
                                                <span class="badge bg-danger">Rejected</span>
                                                break;
                                            case TrainingRequestStatus.Cancelled:
                                                <span class="badge bg-secondary">Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @(string.IsNullOrEmpty(req.TrainerResponse) ? "—" : req.TrainerResponse)
                                    </td>
                                    <td class="text-end">
                                        @if (req.Status == TrainingRequestStatus.Pending)
                                        {
                                            <form asp-action="CancelRequest" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requestId" value="@req.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Cancel this request?');">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
