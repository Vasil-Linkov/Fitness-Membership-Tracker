@model BrowseTrainersViewModel

@{
    ViewData["Title"] = "Find a Trainer";
    var days = Enum.GetValues<DayOfWeek>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Find a Trainer</h2>
            <p class="text-muted mb-0">Browse trainers available on the selected day.</p>
        </div>
        <a asp-controller="Trainer" asp-action="MyTrainer" class="btn btn-outline-primary">My Trainer</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Active request / relationship banners *@
    @if (Model.CurrentRelationship != null)
    {
        <div class="alert alert-info">
            You are currently being trained by
            <strong>@Model.CurrentRelationship.Trainer?.FirstName @Model.CurrentRelationship.Trainer?.LastName</strong>.
            <a asp-action="MyTrainer" class="alert-link ms-2">View details</a>
        </div>
    }
    else if (Model.ActiveRequest != null)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span>
                You have a pending request to
                <strong>@Model.ActiveRequest.Trainer?.FirstName @Model.ActiveRequest.Trainer?.LastName</strong>.
                Waiting for a response.
            </span>
            <form asp-action="CancelRequest" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" value="@Model.ActiveRequest.Id" />
                <button type="submit" class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('Cancel this request?');">
                    Cancel Request
                </button>
            </form>
        </div>
    }

    @* Day filter *@
    <div class="d-flex flex-wrap gap-2 mb-4">
        @foreach (var d in days)
        {
            <a asp-action="Browse" asp-route-day="@d"
               class="btn btn-sm @(Model.SelectedDay == d ? "btn-primary" : "btn-outline-secondary")">
                @d.ToString()
            </a>
        }
    </div>

    @if (!Model.Trainers.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <p class="text-muted mb-0">
                    No trainers are available on <strong>@Model.SelectedDay</strong> right now.
                    Try a different day.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var card in Model.Trainers)
            {
                var isFull = card.ActiveTrainees >= card.MaxTrainees;
                var hasActiveRelOrRequest = Model.CurrentRelationship != null || Model.ActiveRequest != null;

                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm h-100 @(isFull ? "border-secondary" : "border-0")">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="fw-bold mb-0">
                                        @card.Trainer.FirstName @card.Trainer.LastName
                                    </h5>
                                    <span class="badge bg-info text-dark">@card.Trainer.Specialization</span>
                                </div>
                                @if (isFull)
                                {
                                    <span class="badge bg-secondary">Full</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                            </div>

                            <p class="text-muted small mb-1">
                                <i class="me-1">📍</i>@card.Trainer.Location?.City
                            </p>

                            @* Capacity bar *@
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Trainees</span>
                                    <span>@card.ActiveTrainees / @card.MaxTrainees</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    @{
                                        var pct = card.MaxTrainees > 0
                                            ? (int)((double)card.ActiveTrainees / card.MaxTrainees * 100)
                                            : 100;
                                        var barColor = pct >= 100 ? "bg-secondary"
                                                     : pct >= 80 ? "bg-warning"
                                                     : "bg-success";
                                    }
                                    <div class="progress-bar @barColor" role="progressbar"
                                         style="width: @pct%"></div>
                                </div>
                            </div>

                            @* Availability slots for selected day *@
                            @if (card.TodaySlots.Any())
                            {
                                <p class="small fw-semibold mb-1 text-muted">
                                    Available on @Model.SelectedDay:
                                </p>
                                <ul class="list-unstyled small mb-3">
                                    @foreach (var slot in card.TodaySlots)
                                    {
                                        <li>
                                            🕐 @slot.StartTime.ToString(@"hh\:mm") – @slot.EndTime.ToString(@"hh\:mm")
                                        </li>
                                    }
                                </ul>
                            }

                            <div class="mt-auto">
                                @if (hasActiveRelOrRequest || isFull)
                                {
                                    <button class="btn btn-secondary w-100" disabled>
                                        @(isFull ? "Trainer Full" : "Request Unavailable")
                                    </button>
                                }
                                else
                                {
                                    <a asp-action="Request" asp-route-trainerId="@card.Trainer.Id"
                                       class="btn btn-primary w-100">
                                        Request This Trainer
                                    </a>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
