@model IEnumerable<Fitness_Membership_Tracker.Data.DataModels.Member>

@{
    ViewData["Title"] = "Members";
}

<h2 class="mb-3">Members</h2>

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Any())
        {
            <p class="text-muted">No members registered.</p>
        }
        else
        {
            <table class="table table-striped">

                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Membership</th>
                        <th>Payments</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td>@member.Email</td>

                            <td>
                                @if (member.MembershipId == null)
                                {
                                    <span class="text-muted">None</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>

                            <td>@member.Payments?.Count</td>

                        </tr>
                    }
                </tbody>

            </table>
        }

    </div>
</div>