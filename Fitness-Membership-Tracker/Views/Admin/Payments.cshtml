@model IEnumerable<Fitness_Membership_Tracker.Data.DataModels.Payment>

@{
    ViewData["Title"] = "Payments";
}

<h2>Payments</h2>

<a asp-action="CreatePayment">Create Payment</a>

<table border="1">

    <tr>
        <th>Member</th>
        <th>Membership</th>
        <th>Amount</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.MemberId</td>
            <td>@p.MembershipId</td>
            <td>@p.Amount</td>
        </tr>
    }

</table>

<br />

<a asp-action="Dashboard">Back</a>