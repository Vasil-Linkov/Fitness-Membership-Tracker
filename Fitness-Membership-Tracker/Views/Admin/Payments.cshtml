@model IEnumerable<Fitness_Membership_Tracker.Data.DataModels.Payment>

@{
    ViewData["Title"] = "Admin - Payments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Payments</h2>
            <p class="text-muted mb-0">View all recorded payments.</p>
        </div>
        <a asp-action="CreatePayment" class="btn btn-primary">Create Payment</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <p class="text-muted mb-0">No payments found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Member</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Membership Id</th>
                                <th>Employee</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.OrderByDescending(p => p.PaymentDate))
                            {
                                <tr>
                                    <td>@payment.PaymentDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@payment.Member?.Email</td>
                                    <td>@payment.Amount @payment.Currency</td>
                                    <td>@payment.PaymentMethod</td>
                                    <td>@payment.MembershipId</td>
                                    <td>@(payment.Employee?.Email ?? "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>