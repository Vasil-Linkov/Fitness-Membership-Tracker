@model IEnumerable<Fitness_Membership_Tracker.Data.DataModels.Payment>

@{
    ViewData["Title"] = "Admin - Payments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Payments</h2>
            <p class="text-muted mb-0">View all recorded payments.</p>
        </div>
        <a asp-action="CreatePayment" class="btn btn-primary">Create Payment</a>
    </div>

    @* ── Search bar ──────────────────────────────────────────────────────── *@
    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-5">
            <label class="form-label text-muted small mb-1">Search by payer email</label>
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="e.g. aleksand…"
                   class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label text-muted small mb-1">Filter by date</label>
            <input type="date"
                   name="date"
                   value="@ViewBag.Date"
                   class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
            <a asp-action="Payments" class="btn btn-outline-secondary btn-sm ms-1">Clear</a>
        </div>
    </form>

    @* ── Results ─────────────────────────────────────────────────────────── *@
    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <p class="text-muted mb-0">
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string) || !string.IsNullOrWhiteSpace(ViewBag.Date as string))
                    {
                        <span>No payments match your search criteria.</span>
                    }
                    else
                    {
                        <span>No payments found.</span>
                    }
                </p>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">
                        Showing <strong>@Model.Count()</strong> payment@(Model.Count() != 1 ? "s" : "")
                        @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
                        {
                            <span> matching &ldquo;@ViewBag.Search&rdquo;</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(ViewBag.Date as string))
                        {
                            <span> on @DateTime.Parse(ViewBag.Date).ToString("dd MMM yyyy")</span>
                        }
                    </span>
                    @{
                        var total = Model.Sum(p => p.Amount);
                    }
                    <span class="text-muted small fw-semibold">
                        Total: @total.ToString("0.00") @(Model.FirstOrDefault()?.Currency ?? "EUR")
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Member</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Membership Id</th>
                                <th>Employee</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.OrderByDescending(p => p.PaymentDate))
                            {
                                <tr>
                                    <td>@payment.PaymentDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@payment.Member?.Email</td>
                                    <td>@payment.Amount @payment.Currency</td>
                                    <td>@payment.PaymentMethod</td>
                                    <td>@payment.MembershipId</td>
                                    <td>@(payment.Employee?.Email ?? "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
