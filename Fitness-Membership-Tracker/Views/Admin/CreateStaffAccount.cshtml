@model CreateStaffAccountViewModel

@{
    ViewData["Title"] = "Admin — Create Staff Account";

    // Build a JS lookup: profile id → email, for both trainer and employee lists
    // so the email field can be auto-filled when the user picks from a dropdown.
    var trainerEmails = Model.Trainers
        .Where(t => t.Value != null)
        .ToDictionary(
            t => t.Value!,
            t => t.Text!.Contains('(') && t.Text!.Contains(')')
                ? t.Text[(t.Text.LastIndexOf('(') + 1)..t.Text.LastIndexOf(')')]
                : string.Empty);

    var employeeEmails = Model.Employees
        .Where(e => e.Value != null)
        .ToDictionary(
            e => e.Value!,
            e => e.Text!.Contains('(') && e.Text!.Contains(')')
                ? e.Text[(e.Text.LastIndexOf('(') + 1)..e.Text.LastIndexOf(')')]
                : string.Empty);

    var trainerEmailJson  = System.Text.Json.JsonSerializer.Serialize(trainerEmails);
    var employeeEmailJson = System.Text.Json.JsonSerializer.Serialize(employeeEmails);
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary mb-3">← Back to Dashboard</a>
        <h2 class="mb-1">Create Staff Account</h2>
        <p class="text-muted mb-0">
            Create a login account for a trainer or employee and link it to their existing profile.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <form asp-action="CreateStaffAccount" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                        @* ── Role selector ────────────────────────────────────── *@
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Staff Role</label>
                            <div class="d-flex gap-3">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio"
                                           name="Role" id="roleTrainer" value="Trainer"
                                           @(Model.Role == "Trainer" ? "checked" : "")
                                           onchange="toggleProfile()" />
                                    <label class="form-check-label" for="roleTrainer">
                                        🏃 Trainer
                                    </label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio"
                                           name="Role" id="roleEmployee" value="Employee"
                                           @(Model.Role == "Employee" ? "checked" : "")
                                           onchange="toggleProfile()" />
                                    <label class="form-check-label" for="roleEmployee">
                                        👔 Employee
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        @* ── Trainer profile selector ─────────────────────────── *@
                        <div id="trainerSection"
                             class="mb-3"
                             style="display:@(Model.Role == "Trainer" ? "block" : "none")">
                            <label asp-for="TrainerId" class="form-label fw-semibold">
                                Trainer Profile
                            </label>
                            <select asp-for="TrainerId" id="trainerSelect"
                                    asp-items="Model.Trainers"
                                    class="form-select"
                                    onchange="fillEmailFromTrainer(this.value)">
                                <option value="">— Select trainer —</option>
                            </select>
                            <span asp-validation-for="TrainerId" class="text-danger small"></span>
                        </div>

                        @* ── Employee profile selector ────────────────────────── *@
                        <div id="employeeSection"
                             class="mb-3"
                             style="display:@(Model.Role == "Employee" ? "block" : "none")">
                            <label asp-for="EmployeeId" class="form-label fw-semibold">
                                Employee Profile
                            </label>
                            <select asp-for="EmployeeId" id="employeeSelect"
                                    asp-items="Model.Employees"
                                    class="form-select"
                                    onchange="fillEmailFromEmployee(this.value)">
                                <option value="">— Select employee —</option>
                            </select>
                            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        @* ── Credentials ──────────────────────────────────────── *@
                        <h6 class="fw-semibold text-muted mb-3">Login Credentials</h6>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                Email
                                <span class="text-muted fw-normal small">
                                    (leave blank to use the profile's email)
                                </span>
                            </label>
                            <input asp-for="Email" id="emailInput" class="form-control"
                                   placeholder="Auto-filled from profile — or type a custom email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label">Password</label>
                                <input asp-for="Password" type="password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Create Account</button>
                            <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Email lookup maps built server-side: { "id": "email@domain.com", … }
        var trainerEmails  = @Html.Raw(trainerEmailJson);
        var employeeEmails = @Html.Raw(employeeEmailJson);

        function fillEmailFromTrainer(id) {
            var email = trainerEmails[id] || '';
            document.getElementById('emailInput').value = email;
        }

        function fillEmailFromEmployee(id) {
            var email = employeeEmails[id] || '';
            document.getElementById('emailInput').value = email;
        }

        function toggleProfile() {
            var isTrainer = document.getElementById('roleTrainer').checked;
            document.getElementById('trainerSection').style.display  = isTrainer ? 'block' : 'none';
            document.getElementById('employeeSection').style.display = isTrainer ? 'none'  : 'block';
            // Clear email when switching roles so stale value isn't carried over
            document.getElementById('emailInput').value = '';
        }
    </script>
}
