@model ManageTrainerScheduleViewModel

@{
    ViewData["Title"] = "Admin - Trainer Schedule";
    var dayNames = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-action="Trainers" class="btn btn-sm btn-outline-secondary mb-3">← Back to Trainers</a>
        <h2 class="mb-1">Manage Schedule</h2>
        <p class="text-muted mb-0">
            Availability slots for <strong>@Model.TrainerName</strong>.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        @* ── Current slots ── *@
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header border-0">
                    <h5 class="mb-0 fw-semibold">Current Slots</h5>
                </div>
                <div class="card-body">
                    @if (!Model.ExistingSlots.Any())
                    {
                        <p class="text-muted mb-0">No availability slots defined yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Day</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slot in Model.ExistingSlots.OrderBy(s => s.DayOfWeek).ThenBy(s => s.StartTime))
                                    {
                                        <tr>
                                            <td>@dayNames[slot.DayOfWeek]</td>
                                            <td>@slot.StartTime.ToString(@"hh\:mm")</td>
                                            <td>@slot.EndTime.ToString(@"hh\:mm")</td>
                                            <td class="text-end">
                                                <form asp-action="RemoveTrainerSlot" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="slotId" value="@slot.Id" />
                                                    <input type="hidden" name="trainerId" value="@Model.TrainerId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Remove this slot?');">
                                                        Remove
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Add new slot ── *@
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header border-0">
                    <h5 class="mb-0 fw-semibold">Add Slot</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddTrainerSlot" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TrainerId" value="@Model.TrainerId" />
                        <input type="hidden" name="TrainerName" value="@Model.TrainerName" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="DayOfWeek" class="form-label">Day of Week</label>
                            <select asp-for="DayOfWeek" class="form-select">
                                @for (int d = 0; d < 7; d++)
                                {
                                    <option value="@d">@dayNames[d]</option>
                                }
                            </select>
                            <span asp-validation-for="DayOfWeek" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StartTime" class="form-label">Start Time</label>
                            <input asp-for="StartTime" type="time" class="form-control" />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EndTime" class="form-label">End Time</label>
                            <input asp-for="EndTime" type="time" class="form-control" />
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Add Slot</button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
