@model IEnumerable<Trainer>

@{
    ViewData["Title"] = "Admin - Trainers";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Trainers</h2>
            <p class="text-muted mb-0">View and manage all trainers in the system.</p>
        </div>
        <a asp-action="CreateTrainer" class="btn btn-primary">Add Trainer</a>
    </div>

   
    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label class="form-label text-muted small mb-1">Location</label>
            <select name="locationId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="" selected>All Locations</option>
                @foreach (var loc in ViewBag.Locations as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                {
                    var selected = ViewBag.SelectedLocationId != null && loc.Value == ViewBag.SelectedLocationId.ToString() ? "selected" : "";
                    <option value="@loc.Value">@loc.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small mb-1">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Name, email or specialization…"
                   class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
            <a asp-action="Trainers" class="btn btn-outline-secondary btn-sm ms-1">Clear</a>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No trainers found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Specialization</th>
                                <th>Location</th>
                                <th>Hire Date</th>
                                <th>Salary</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trainer in Model)
                            {
                                <tr>
                                    <td>@trainer.FirstName @trainer.LastName</td>
                                    <td>@trainer.Email</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@trainer.Specialization</span>
                                    </td>
                                    <td>@trainer.Location?.City</td>
                                    <td>@trainer.HireDate.ToShortDateString()</td>
                                    <td>@trainer.Salary.ToString("C")</td>
                                    <td class="text-end">
                                        <form asp-action="DeleteTrainer" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@trainer.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this trainer?');">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
