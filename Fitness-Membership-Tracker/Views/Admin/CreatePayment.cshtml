@model Fitness_Membership_Tracker.Data.DataModels.Payment

@{
    ViewData["Title"] = "Create Payment";
}

<h2>Create Payment</h2>

<form method="post">

    <div>
        <label>Member</label>
        <select asp-for="MemberId" asp-items="ViewBag.Members"></select>
    </div>

    <div>
        <label>Membership</label>
        <select asp-for="MembershipId" asp-items="ViewBag.Memberships"></select>
    </div>

    <div>
        <label>Amount</label>
        <input asp-for="Amount" />
    </div>

    <button type="submit">Create</button>

</form>

<br />

<a asp-action="Payments">Back</a>