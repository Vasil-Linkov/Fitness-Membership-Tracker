@{
    ViewData["Title"] = "Admin - Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Admin Dashboard</h2>
            <p class="text-muted mb-0">Overview of the main system data.</p>
        </div>
        <a asp-action="CreateStaffAccount" class="btn btn-primary">
            + Create Staff Account
        </a>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Employees</h6>
                    <h2 class="mb-3">@ViewBag.EmployeeCount</h2>
                    <a asp-action="Employees" class="btn btn-outline-primary btn-sm">Manage Employees</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Trainers</h6>
                    <h2 class="mb-3">@ViewBag.TrainerCount</h2>
                    <a asp-action="Trainers" class="btn btn-outline-primary btn-sm">Manage Trainers</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Members</h6>
                    <h2 class="mb-3">@ViewBag.MemberCount</h2>
                    <a asp-action="Members" class="btn btn-outline-primary btn-sm">Manage Members</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Memberships</h6>
                    <h2 class="mb-3">@ViewBag.MembershipCount</h2>
                    <a asp-action="Memberships" class="btn btn-outline-primary btn-sm">Manage Memberships</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Payments</h6>
                    <h2 class="mb-3">@ViewBag.PaymentCount</h2>
                    <a asp-action="Payments" class="btn btn-outline-primary btn-sm">Manage Payments</a>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1">Visits — Last 30 Days</h4>
            <p class="text-muted small mb-0">Quick overview of gym traffic.</p>
        </div>
        <a asp-action="Visits" class="btn btn-outline-secondary btn-sm">Full Visits Page</a>
    </div>

    <partial name="_VisitStatsPartial" model="(VisitStatsViewModel)ViewBag.VisitStats" />
</div>
