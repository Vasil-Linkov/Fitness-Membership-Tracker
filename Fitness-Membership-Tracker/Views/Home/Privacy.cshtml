@{
    ViewData["Title"] = "About";
}



<div class="container min-vh-100 d-flex align-items-center justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">

                <div class="text-center mb-5">
                    <h1 class="fw-bold">About Our Fitness System</h1>
                    <p class="text-muted">
                        Simple. Secure. Designed to keep you moving.
                    </p>
                </div>

                <section class="mb-4">
                    <h3 class="fw-semibold mb-3">Project Overview</h3>
                    <p>
                        This fitness membership tracking system was developed as a graduation project
                        with the goal of providing a clean, efficient, and secure way to manage gym
                        memberships and user data.
                    </p>
                    <p>
                        The system allows members to view their personal information, membership status,
                        and expiration dates, while employees can manage memberships and user records
                        through controlled access.
                    </p>
                </section>

                <section class="mb-4">
                    <h3 class="fw-semibold mb-3">Why This Project</h3>
                    <p>
                        Modern fitness centers rely heavily on accurate data, accessibility, and user
                        experience. This project focuses on creating a reliable backend combined with
                        a minimal and intuitive interface.
                    </p>
                    <p>
                        By limiting public access and protecting sensitive information, the system
                        ensures both usability and security.
                    </p>
                </section>

                <section class="mb-4">
                    <h3 class="fw-semibold mb-3">Our Philosophy</h3>
                    <p>
                        Fitness is not built overnight. It is the result of discipline, consistency,
                        and commitment.
                    </p>
                    <p class="fw-semibold">
                        Track your progress. Respect your time. Stay committed.
                    </p>
                </section>

                <section class="mb-4">
                    <h3 class="fw-semibold mb-3">Technology Stack</h3>
                    <ul class="mb-0">
                        <li>ASP.NET Core (.NET 8)</li>
                        <li>C# with Razor Pages</li>
                        <li>SQL Server (SQL Management Studio)</li>
                        <li>Bootstrap-based responsive design</li>
                    </ul>
                </section>

                <hr class="my-5" />

                <div class="text-center">
                    <p class="fw-semibold mb-1">
                        Strong systems build strong habits.
                    </p>
                    <p class="text-muted mb-0">
                        And strong habits build results.
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>
