@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Home";
}

<style>
    .hero-section {
        min-height: 88vh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        padding: 4rem 0;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse at 80% 50%, rgba(232,25,44,0.12) 0%, transparent 60%),
            radial-gradient(ellipse at 20% 80%, rgba(232,25,44,0.06) 0%, transparent 50%);
        pointer-events: none;
    }

    .hero-bg-text {
        position: absolute;
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 900;
        font-size: clamp(5rem, 22vw, 22rem);
        color: rgba(255,255,255,0.015);
        text-transform: uppercase;
        letter-spacing: -0.02em;
        white-space: nowrap;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        user-select: none;
        pointer-events: none;
        z-index: 0;
    }

    .hero-content {
        position: relative;
        z-index: 1;
    }

    .hero-eyebrow {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.3em;
        color: #e8192c;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .hero-eyebrow::before {
        content: '';
        display: inline-block;
        width: 32px;
        height: 2px;
        background: #e8192c;
    }

    .hero-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 900;
        font-size: clamp(3.5rem, 9vw, 8rem);
        text-transform: uppercase;
        line-height: 0.92;
        letter-spacing: -0.01em;
        color: #ffffff;
        margin-bottom: 1.5rem;
    }

    .hero-title .accent {
        color: #e8192c;
        display: block;
        text-shadow: 0 0 60px rgba(232,25,44,0.4);
    }

    .hero-desc {
        font-size: 1.05rem;
        color: rgba(255,255,255,0.55);
        max-width: 480px;
        line-height: 1.7;
        margin-bottom: 2.5rem;
        font-weight: 300;
    }

    .hero-cta-group {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-hero-primary {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #fff;
        background: #e8192c;
        border: none;
        padding: 0.9rem 2.8rem;
        border-radius: 2px;
        cursor: pointer;
        transition: all .25s;
        box-shadow: 0 6px 30px rgba(232,25,44,0.4);
        text-decoration: none;
        display: inline-block;
    }

    .btn-hero-primary:hover {
        background: #c0101f;
        transform: translateY(-2px);
        box-shadow: 0 10px 40px rgba(232,25,44,0.55);
        color: #fff;
    }

    .btn-hero-secondary {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: rgba(255,255,255,0.7);
        background: transparent;
        border: 1px solid rgba(255,255,255,0.2);
        padding: 0.9rem 2.4rem;
        border-radius: 2px;
        cursor: pointer;
        transition: all .25s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-hero-secondary:hover {
        border-color: rgba(255,255,255,0.5);
        color: #fff;
        background: rgba(255,255,255,0.05);
    }

    /* Stats strip */
    .stats-strip {
        display: flex;
        gap: 3rem;
        margin-top: 4rem;
        padding-top: 2.5rem;
        border-top: 1px solid rgba(255,255,255,0.07);
        flex-wrap: wrap;
    }

    .stat-item {}

    .stat-number {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 900;
        font-size: 2.8rem;
        line-height: 1;
        color: #fff;
    }

    .stat-number span {
        color: #e8192c;
    }

    .stat-label {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: rgba(255,255,255,0.4);
        margin-top: 0.2rem;
    }

    /* Services */
    .services-section {
        padding: 5rem 0;
        background: #111;
        border-top: 1px solid rgba(255,255,255,0.05);
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .service-card {
        background: #1a1a1a;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 4px;
        padding: 2rem;
        transition: all .3s;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .service-card::before {
        content: '';
        position: absolute;
        bottom: 0; left: 0; right: 0;
        height: 2px;
        background: #e8192c;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform .3s;
    }

    .service-card:hover::before { transform: scaleX(1); }

    .service-card:hover {
        border-color: rgba(232,25,44,0.25);
        transform: translateY(-4px);
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }

    .service-icon {
        font-size: 2rem;
        margin-bottom: 1.25rem;
        display: block;
    }

    .service-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 1.15rem;
        text-transform: uppercase;
        color: #fff;
        margin-bottom: 0.6rem;
    }

    .service-desc {
        font-size: 0.88rem;
        color: rgba(255,255,255,0.45);
        line-height: 1.65;
        margin: 0;
    }

    .section-eyebrow {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.3em;
        color: #e8192c;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
    }

    .section-eyebrow::before, .section-eyebrow::after {
        content: '';
        display: inline-block;
        width: 24px;
        height: 1px;
        background: #e8192c;
    }

    .section-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 900;
        font-size: clamp(2rem, 4vw, 3.5rem);
        text-transform: uppercase;
        color: #fff;
        margin-bottom: 0.5rem;
    }

    .section-sub {
        color: rgba(255,255,255,0.4);
        font-size: 0.95rem;
        max-width: 500px;
        margin: 0 auto 3.5rem;
        font-weight: 300;
    }

    /* Welcome back variation */
    .hero-logged-in .hero-title {
        font-size: clamp(3rem, 7vw, 6rem);
    }
</style>

@if (!SignInManager.IsSignedIn(User))
{
    <!-- GUEST HERO -->
    <div class="hero-section">
        <div class="hero-bg-text">FITZONE</div>
        <div class="container hero-content" style="max-width:1320px;">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="hero-eyebrow">Ready to change your physique</div>
                    <h1 class="hero-title">
                        Keep Body<br>
                        <span class="accent">Fit &amp; Strong</span>
                    </h1>
                    <p class="hero-desc">
                        Manage your fitness journey with clarity and control.
                        Track memberships, log workouts, connect with certified trainers
                        — all in one place.
                    </p>
                    <div class="hero-cta-group">
                        <a asp-controller="Account" asp-action="Register" class="btn-hero-primary">Join Now</a>
                        <a asp-controller="Account" asp-action="Login" class="btn-hero-secondary">Sign In</a>
                    </div>

                    <div class="stats-strip">
                        <div class="stat-item">
                            <div class="stat-number">8<span>+</span></div>
                            <div class="stat-label">Locations</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">18<span>+</span></div>
                            <div class="stat-label">Expert Trainers</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">4<span></span></div>
                            <div class="stat-label">Membership Tiers</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">24<span>/7</span></div>
                            <div class="stat-label">Elite Access</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SERVICES -->
    <div class="services-section">
        <div class="container text-center" style="max-width:1320px;">
            <div class="section-eyebrow">Our Services</div>
            <h2 class="section-title">Built For You</h2>
            <p class="section-sub">Everything you need to track your fitness, manage your membership, and grow with a trainer.</p>

            <div class="row g-4">
                <div class="col-sm-6 col-lg-3">
                    <div class="service-card text-start">
                        <span class="service-icon">🏋️</span>
                        <div class="service-title">Workout Logging</div>
                        <p class="service-desc">Record every rep, set, and session. Track weight, duration, and notes for complete training history.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="service-card text-start">
                        <span class="service-icon">🎯</span>
                        <div class="service-title">Personal Trainers</div>
                        <p class="service-desc">Browse certified trainers by day and specialization. Send requests and get personalized coaching.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="service-card text-start">
                        <span class="service-icon">💳</span>
                        <div class="service-title">Membership Plans</div>
                        <p class="service-desc">Four tiers from Basic to Ultimate. Flexible access from single-location to nationwide and 24/7 entry.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="service-card text-start">
                        <span class="service-icon">📊</span>
                        <div class="service-title">Visit Analytics</div>
                        <p class="service-desc">Admins get real-time charts of gym traffic, peak days, and trends to optimize operations.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- LOGGED-IN WELCOME -->
    <div class="hero-section hero-logged-in">
        <div class="hero-bg-text">WELCOME</div>
        <div class="container hero-content" style="max-width:1320px;">
            <div class="hero-eyebrow">FitZone Member Portal</div>
            <h1 class="hero-title">
                Welcome<br>
                <span class="accent">Back</span>
            </h1>
            <p class="hero-desc">
                Your account is ready. Track your membership status, log today's workout,
                or find a trainer to level up your training.
            </p>
            <div class="hero-cta-group">
                <a asp-controller="Membership" asp-action="YourMembership" class="btn-hero-primary">View Membership</a>
                <a asp-controller="Workout" asp-action="Log" class="btn-hero-secondary">Log Workout</a>
            </div>

            <div class="stats-strip">
                <div class="stat-item">
                    <div class="stat-number" style="font-size:1.1rem;color:rgba(255,255,255,0.5);font-weight:400;font-family:'Barlow',sans-serif;text-transform:none;letter-spacing:0;">
                        Stay consistent. Stay committed.
                    </div>
                </div>
            </div>
        </div>
    </div>
}
