@model WorkoutHistoryViewModel

@{
    ViewData["Title"] = "Workout History";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Workout History</h2>
            <p class="text-muted mb-0">All your logged workout sessions.</p>
        </div>
        <a asp-action="Log" class="btn btn-primary">Log New Workout</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Logs.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <p class="text-muted mb-3">You haven't logged any workouts yet.</p>
                <a asp-action="Log" class="btn btn-primary">Log Your First Workout</a>
            </div>
        </div>
    }
    else
    {
        <div class="accordion" id="workoutAccordion">
            @foreach (var (log, index) in Model.Logs.Select((l, i) => (l, i)))
            {
                <div class="accordion-item mb-2 border rounded shadow-sm">
                    <h2 class="accordion-header" id="heading-@log.Id">
                        <button class="accordion-button @(index > 0 ? "collapsed" : "")"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapse-@log.Id"
                                aria-expanded="@(index == 0 ? "true" : "false")"
                                aria-controls="collapse-@log.Id">
                            <div class="d-flex w-100 justify-content-between align-items-center pe-3">
                                <span class="fw-semibold">
                                    @log.LogDate.ToLocalTime().ToString("dddd, dd MMMM yyyy")
                                    &nbsp;<span class="text-muted small">@log.LogDate.ToLocalTime().ToString("HH:mm")</span>
                                </span>
                                <span class="badge bg-secondary rounded-pill">
                                    @log.Exercises.Count exercise@(log.Exercises.Count != 1 ? "s" : "")
                                </span>
                            </div>
                        </button>
                    </h2>

                    <div id="collapse-@log.Id"
                         class="accordion-collapse collapse @(index == 0 ? "show" : "")"
                         aria-labelledby="heading-@log.Id"
                         data-bs-parent="#workoutAccordion">
                        <div class="accordion-body">

                            @if (!string.IsNullOrWhiteSpace(log.Notes))
                            {
                                <p class="text-muted fst-italic mb-3">"@log.Notes"</p>
                            }

                            <div class="table-responsive">
                                <table class="table table-sm table-striped align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Exercise</th>
                                            <th class="text-center">Sets</th>
                                            <th class="text-center">Reps</th>
                                            <th class="text-center">Weight (kg)</th>
                                            <th class="text-center">Duration (min)</th>
                                            <th>Notes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ex in log.Exercises)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@ex.ExerciseName</td>
                                                <td class="text-center">@(ex.Sets?.ToString() ?? "—")</td>
                                                <td class="text-center">@(ex.Reps?.ToString() ?? "—")</td>
                                                <td class="text-center">@(ex.WeightKg?.ToString("0.#") ?? "—")</td>
                                                <td class="text-center">@(ex.DurationMinutes?.ToString() ?? "—")</td>
                                                <td class="text-muted small">@(ex.Notes ?? "")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-3 text-end">
                                <form asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@log.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Delete this workout log?');">
                                        Delete
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
